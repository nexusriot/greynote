# IDE / editors
.idea/
*.iml
.vscode/
*.swp
*~

# Runtime data (anchored to repo root — do NOT ignore the Android `data/` source package)
/data/

# SQLite files. Real deployments keep the database in /var/lib/greynote or a
# Docker volume; one appearing in the tree is a stray run (the binary's default
# SQLITE_PATH is ./notes.db).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Release artifacts (make dist)
/dist/

# Local scratch from manual API pokes
cookie.txt
cookies.txt

# Go build output
backend/greynote
backend/*.exe
*.test
*.out

# Node dependencies, wherever they appear
node_modules/

# Web client build
frontend/dist/

# Desktop client build (bundle.js is generated by scripts/build-desktop.sh)
electron/dist/
electron/out/
electron/renderer/bundle.js
electron/renderer/bundle.js.map
electron/test/screenshots/

# Android build
android/.gradle/
android/.kotlin/
android/app/build/
android/build/
android/local.properties
android/app/release/
android/captures/

# Android signing secrets
*.jks
*.keystore
keystore.properties

# Gradle wrapper binary (keep .properties, ignore jars)
android/gradle/wrapper/gradle-wrapper.jar
android/gradlew
android/gradlew.bat

# Secrets / local env
.env
.env.local

# OS
.DS_Store
Thumbs.db
